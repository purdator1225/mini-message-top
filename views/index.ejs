<html>

<link rel="stylesheet" href="/styles.css">
  <body>
    <%- include('navbar',{links:links}) %> 

    <h1>Messages</h1>

    <% messages.forEach(message => { %>

        <h4><%=message.user%></>
        <p><%= message.text%></p>
        <p>Added <%=message.added %></p>
     
    <% }) %>
  </body>
</html>
